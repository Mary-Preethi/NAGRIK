# Environment Variables for NAGRIK
DATABASE_URL="file:./dev.db"
JWT_SECRET="nagrik-secret-key-change-in-production-min-32-chars"
SESSION_SECRET="nagrik-session-secret-change-in-production"
GEMINI_API_KEY="" # Optional: Gemini API Key for heuristic AI enrichment
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="NAGRIK"
NEXT_PUBLIC_APP_TAGLINE="See. Speak. Act."

# Secure Administrator Account Configuration for Seed/Setup
# The database seed script requires these variables to provision the Admin account.
ADMIN_EMAIL="admin@nagrik.local"
ADMIN_PASSWORD="NagrikAdmin@2026"



